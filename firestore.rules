rules_version = '2';

// PicBook 전용 Firebase 프로젝트의 Firestore 규칙.
// 배포: firebase deploy --only firestore:rules  (docs/FIREBASE_SETUP.md)
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    // 관리자 = admins/{uid} 문서가 있는 계정. 이 문서는 콘솔에서만 만든다.
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function keyPath(key) {
      return /databases/$(database)/documents/pass_keys/$(key);
    }
    function passPath(uid, category) {
      return /databases/$(database)/documents/users/$(uid)/passes/$(category);
    }

    match /admins/{uid} {
      allow get: if isOwner(uid);
      allow list, write: if false;
    }

    // 회원 문서 — 본인만. 아이디와 가입일은 바꿀 수 없다.
    match /users/{uid} {
      allow get: if isOwner(uid) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(uid)
        && request.resource.data.loginId is string
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() >= 2
        && request.resource.data.nickname.size() <= 10;
      allow update: if isOwner(uid)
        && request.resource.data.loginId == resource.data.loginId
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;

      // 타자 기록 — 본인이 추가만 할 수 있다
      match /records/{recordId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          && request.resource.data.cpm is number
          && request.resource.data.cpm >= 0
          && request.resource.data.cpm <= 1500
          && request.resource.data.accuracy is number
          && request.resource.data.accuracy >= 0
          && request.resource.data.accuracy <= 100;
        allow update, delete: if false;
      }

      // 이용권 — 문서가 있으면 그 분류가 열린다.
      // 회원은 "이용권 코드 1회 차감"과 한 묶음(트랜잭션)일 때만 만들 수 있다.
      // 결제 서버(Admin SDK)는 규칙을 거치지 않고 직접 쓴다.
      match /passes/{category} {
        allow read: if isOwner(uid) || isAdmin();
        allow create: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['category', 'source', 'key', 'grantedAt'])
          && request.resource.data.category == category
          && request.resource.data.source == 'key'
          && request.resource.data.key is string
          && get(keyPath(request.resource.data.key)).data.category == category
          && getAfter(keyPath(request.resource.data.key)).data.uses
             == get(keyPath(request.resource.data.key)).data.uses + 1;
        allow create, update, delete: if isAdmin();
      }
    }

    // 이용권 코드 — 코드를 정확히 아는 사람만 그 문서 하나를 읽을 수 있다(목록 조회 불가).
    match /pass_keys/{key} {
      allow get: if signedIn();
      allow list, create, delete: if isAdmin();
      allow update: if isAdmin() || (
        signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uses'])
        && request.resource.data.uses == resource.data.uses + 1
        && request.resource.data.uses <= resource.data.maxUses
        && !exists(passPath(request.auth.uid, resource.data.category))
        && existsAfter(passPath(request.auth.uid, resource.data.category))
      );
    }

    // 랭킹 — 누구나 보고, 본인 최고 기록만 올린다(낮아지는 수정 불가)
    match /rankings/{bookId}/entries/{uid} {
      allow read: if true;
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['uid', 'nickname', 'bestCpm', 'accuracy', 'updatedAt'])
        && request.resource.data.uid == uid
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() <= 10
        && request.resource.data.bestCpm is number
        && request.resource.data.bestCpm > 0
        && request.resource.data.bestCpm <= 1500
        && request.resource.data.accuracy >= 90
        && request.resource.data.accuracy <= 100
        && (resource == null || request.resource.data.bestCpm > resource.data.bestCpm);
      allow delete: if isAdmin();
    }

    // 책 내용 — 누구나 읽고(체험 포함), 관리자만 쓴다
    match /picbook_custom_books/{bookId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /picbook_book_edits/{bookId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /picbook_published_timelines/{bookId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /visual_dictionary/{wordId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /visual_dictionary_stories/{storyId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
